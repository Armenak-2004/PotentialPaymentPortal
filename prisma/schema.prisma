generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



enum PaymentStatus {
  PENDING
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum PaymentEventType {
  CREATED
  QUEUED
  PROCESSING_STARTED
  SUCCEEDED
  FAILED
  RETRY_TRIGGERED
}



model Account {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  balance   Decimal  @default(0) @db.Decimal(19, 4)
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  paymentRequests PaymentRequest[]
  transactions    Transaction[]

  @@map("accounts")
}

model PaymentRequest {
  id             String        @id @default(uuid()) @db.Uuid
  accountId      String        @map("account_id") @db.Uuid
  amount         Decimal       @db.Decimal(19, 4)
  reference      String
  description    String?
  status         PaymentStatus @default(PENDING)
  idempotencyKey String        @unique @map("idempotency_key")
  retryCount     Int           @default(0) @map("retry_count")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  account      Account       @relation(fields: [accountId], references: [id])
  transactions Transaction[]
  events       PaymentEvent[]

  @@map("payment_requests")
}

model Transaction {
  id               String          @id @default(uuid()) @db.Uuid
  accountId        String          @map("account_id") @db.Uuid
  paymentRequestId String?         @map("payment_request_id") @db.Uuid
  amount           Decimal         @db.Decimal(19, 4)
  type             TransactionType
  reference        String
  createdAt        DateTime        @default(now()) @map("created_at")

  account        Account         @relation(fields: [accountId], references: [id])
  paymentRequest PaymentRequest? @relation(fields: [paymentRequestId], references: [id])

  @@map("transactions")
}

model PaymentEvent {
  id               String           @id @default(uuid()) @db.Uuid
  paymentRequestId String           @map("payment_request_id") @db.Uuid
  eventType        PaymentEventType @map("event_type")
  metadata         Json?
  createdAt        DateTime         @default(now()) @map("created_at")

  paymentRequest PaymentRequest @relation(fields: [paymentRequestId], references: [id])

  @@map("payment_events")
}